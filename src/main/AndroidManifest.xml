<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to hold a code until the phone is online; grants no access to anything personal. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The sharing phone rings and asks before any code is sent. Sharing is off without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets that request take over the screen like an incoming call, even when the phone is locked. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Get OTP can ask for the fingerprint or screen lock first. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:icon="@mipmap/ic_launcher"
        android:label="OTPair"
        android:supportsRtl="true"
        android:theme="@style/Theme.OTPair">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the system can deliver this broadcast (BROADCAST_SMS), so other apps can't fake a message. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- "Send this code?" over the lock screen. Only this app's own notification opens it. -->
        <activity
            android:name=".ApprovalActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Send and Don't send on the notification. -->
        <receiver android:name=".Decision" android:exported="false" />

        <!-- Holds a code for one minute and asks the owner only if the partner asks. -->
        <service
            android:name=".ShareJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
